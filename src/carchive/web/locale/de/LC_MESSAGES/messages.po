msgstr "Seit einer Weile nur leere Lieferungen: %(count)s seit der letzten mit Inhalt, vor %(age)s."

msgid "No new delivery for '%(kind)s' in %(age)s."
msgstr "Seit %(age)s keine neue Lieferung für „%(kind)s“."

msgid "Even the newest value this vehicle ever reported (%(signal)s) is %(age)s old."
msgstr "Selbst der neueste je gemeldete Wert dieses Fahrzeugs (%(signal)s) ist %(age)s alt."

msgid "The portal failed on the last %(count)s runs in a row."
msgstr "Das Portal ist bei den letzten %(count)s Läufen in Folge fehlgeschlagen."

msgid "%(count)s field(s) have only ever arrived via the one-off 'all' request, never via the recurring 'partial' poll: %(fields)s"
msgstr "%(count)s Feld(er) kamen bisher ausschließlich über die einmalige 'all'-Anfrage, nie über die wiederkehrende 'partial'-Abfrage: %(fields)s"

